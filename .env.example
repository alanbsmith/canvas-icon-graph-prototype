# Copy this file to .env and fill in real values. .env itself is gitignored
# (never commit real credentials), but this example file IS committed so
# anyone setting up the project knows what variables are needed.

# Connection details for the local Neo4j instance (see README.md for setup).
# Default local install uses these exact host/port values -- only the
# password needs to match whatever you set when you first connected.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# Config for the search server (`npm run search-server`).
SEARCH_SERVER_PORT=3000
SEARCH_SERVER_HOST=127.0.0.1
# Required -- the bearer token an MCP client must present to call /mcp.
# The REST API (/api/*) is intentionally left unauthenticated; see
# MAINTAINING.md for why.
MCP_API_KEY=changeme
# Comma-separated list of origins allowed to call /api/* from a browser
# (CORS). Add the docs site's real origin here once this is deployed.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Leave the two below unset for local development. Required only once this
# server runs somewhere other than localhost (see MAINTAINING.md) --
# comma-separated hostnames, e.g. ALLOWED_HOSTS=api.example.com
# ALLOWED_HOSTS=
# ALLOWED_ORIGINS=
